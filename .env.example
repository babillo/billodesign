# Copy to .env.local for local development. Never commit real values.

# Canonical site URL (metadata, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://billodesign.com

# --- AI chat (/api/chat) — server-only ---
# Without it the chat answers with built-in fallback replies.
OPENAI_API_KEY=

# --- Contact form (/api/contact) — Resend + Cloudflare Turnstile ---
RESEND_API_KEY=
# Where submissions are delivered (your Zoho inbox). Server-only, never sent to the browser.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Billodesign <contact@send.billodesign.com>"
CONTACT_FROM_EMAIL=
# Turnstile widget key (public) and secret (server-only).
# Local testing: Cloudflare test keys 1x00000000000000000000AA / 1x0000000000000000000000000000000AA always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
